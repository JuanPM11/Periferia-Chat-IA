# Proveedor LLM (el adaptador lee estas variables; la clave NUNCA se versiona)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo por defecto (puedes sobreescribirlo)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Límites de costo / seguridad del ciclo del agente
AGENT_MAX_ITERS=25
AGENT_MAX_TOKENS_SESSION=100000

# Puerto del backend
PORT=8787

# (opcional) clave de acceso al link público; si se define, el front la pide
# ACCESS_KEY=
